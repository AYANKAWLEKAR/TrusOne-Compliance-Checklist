ENVIRONMENT=development
API_TIMEOUT_SECONDS=15
# From Dashboard → Connect: use Transaction pooler (db.*:6543) or Session pooler (IPv4-friendly).
# Do not wrap the password in square brackets. Direct db.*:5432 is IPv6-only.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EPA_COMPTOX_API_KEY=
DATA_GOV_API_KEY=
GEOIP_BASE_URL=https://ipapi.co/json
ECFR_CACHE_TTL_SECONDS=3600
